Dictionary {
	hash,

	new { hash = nil; # bug; cannot assign {} as default, reserved something something.
		./hash = hash
	}

	keys {; @ruby }
	values {; @ruby }
	has_key? { key; @ruby }
	delete { key; @ruby }
	merge { other; @ruby }
	count {; @ruby }
	empty? {; @ruby }
	clear {; @ruby }
	fetch { key, default; @ruby }
}
