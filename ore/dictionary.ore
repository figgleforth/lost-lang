Dictionary {
	hash,

	new { hash := {};
		./hash = hash
	}

	keys {; @ruby }
	values {; @ruby }
	has_key? { key; @ruby }
	delete { key; @ruby }
	merge { other; @ruby }
	count {; @ruby }
	empty? {; @ruby }
	clear {; @ruby }
	fetch { key, default; @ruby }

	to_s {;
		ks     := keys()
		vs     := values()
		pieces := ks.map({ key, at;
			"`key`: `vs.get(at)`"
		})
		"{`pieces.join(', ')`}"
	}
}
