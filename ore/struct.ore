@load 'ore/member.ore'

``` Valid members syntax:

m := Member()
<Member, mem1: Member, mem2 := Member(), mem3: Member = Member(), m>
```

Struct {
	members: Array<Member>    = []
	names: Array<String>      = []
	type_names: Array<String> = []
	values: Array             = []

	has? { member: Member -> Bool;
		members.include?(member)
	}

	include? { query;
		members.any?({ it;
			it.name == query or it.type == query
		})
	}

	to_s { compact := false;
		formatted_members := members.map({it; it.to_s(compact) }).join(', ')
		"<`formatted_members`>"
	}

	# todo; implement set comparison as well
	@operator == @infix { left, right;
		left.members == right.members
	}

	@operator === @infix { left, right;
		pairs := left.members.zip(right.members)
		pairs.all?({it;
			it.0 === it.1
		})
	}

	@operator + @infix { left, right;
		info := Struct()
		info.members = left.members + right.members
		info
	}
}
