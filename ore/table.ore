Table {
	table_name,
	database: Database,
	columns: Struct,

	infer_table_name_from_class! {; @ruby }

	Self.database,
	Self.all {; @ruby }
	Self.find { id; @ruby }
	Self.find_by { dict; @ruby }
	Self.where { dict; @ruby }
	Self.create { dict; @ruby }
	Self.update { id, dict; @ruby }
	Self.delete { id; @ruby }
}
