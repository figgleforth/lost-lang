@load 'ore/file_system.ore'
@load 'ore/number.ore'
@load 'ore/array.ore'
@load 'ore/dictionary.ore'
@load 'ore/string.ore'
@load 'ore/tags.ore'

Iterable { # todo: This is unused, but here to remind me to think about how to make composing with Iterable behave like Protocols in Swift.
	next {;}
}

Nil {}

Range {}

Tuple {
	values,
}

Bool {
	truthiness,

	# todo: Think about what else might make a boolean true
	new { value := true;
		./truthiness = value != false and value != nil and value != 0 and value != 0.0
	}
}
